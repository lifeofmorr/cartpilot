# ---- CartPilot configuration (copy to .env or export in your shell) ----

# Port the demo server listens on
PORT=4173

# ---- PayPal Sandbox (REQUIRED for real sandbox mode) ----
# Create a free sandbox app at https://developer.paypal.com (Dashboard -> Apps & Credentials -> Sandbox).
# Without these two values, CartPilot runs in SIMULATOR mode: the full agent flow
# works end to end against a local stub that returns PayPal-shaped responses.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox API base (default). Use https://api-m.paypal.com only for live (never for this demo).
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Where PayPal returns the buyer after approval (the demo server's own origin)
RETURN_URL=http://localhost:4173/return
CANCEL_URL=http://localhost:4173/cancel

# ---- Optional: real LLM planning ----
# With no key set, CartPilot uses its built-in deterministic planner (the demo
# and smoke test run with zero keys). With a key, the LLM parses the shopper's
# natural-language goal into structured requirements and narrates its reasoning.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Persistence ----
# Ledger + mandate are stored in a local JSON file by default (zero setup).
LEDGER_PATH=./data/ledger.json
